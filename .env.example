# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
#
# .env.local 은 .gitignore 에 포함되어 깃에 올라가지 않습니다.
# service_role 키와 비공개 키는 절대 커밋하지 마세요.


# ─────────────────────────────────────────────────────────────
# Supabase  (필수)
#
# 대시보드 → 프로젝트 선택 → 좌측 하단 Settings
#   • URL   : Settings → Data API → Project URL
#   • 키    : Settings → API Keys → service_role (Reveal 클릭)
#
# service_role 키는 RLS를 우회하는 마스터 키입니다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출되니 절대 붙이지 마세요.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────
# 운영자 화면 비밀번호  (필수)
#
# /admin 접속 시 요구됩니다. 신청자 1,300명의 연락처가 보이는 화면이라
# 반드시 설정하세요. 없으면 운영자 화면이 열리지 않습니다.
#
# 32자 이상 무작위 문자열을 권장합니다:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
# 로그인 쿠키 서명용 비밀키. 위와 다른 값으로 만드세요.
ADMIN_SESSION_SECRET=


# ─────────────────────────────────────────────────────────────
# 구글 시트 내보내기  (선택 - 비워두면 시트 기능만 비활성화)
#
# 1) console.cloud.google.com → 프로젝트 생성
# 2) API 및 서비스 → 라이브러리 → "Google Sheets API" 사용 설정
# 3) 사용자 인증 정보 → 서비스 계정 만들기 → 키 → JSON 다운로드
# 4) 받은 JSON에서 client_email, private_key 를 아래에 옮겨 적기
# 5) 구글 시트를 만들고 client_email 주소에 "편집자" 권한으로 공유
# 6) 시트 URL의 /d/ 와 /edit 사이 문자열이 SHEET_ID
# ─────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON의 private_key 를 통째로 큰따옴표 안에 넣으세요. \n 은 그대로 둡니다.
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=
