# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
#
# .env.local 은 .gitignore 에 포함되어 깃에 올라가지 않습니다.
# service_role 키와 비공개 키는 절대 커밋하지 마세요.


# ─────────────────────────────────────────────────────────────
# Supabase  (필수)
#
# 대시보드 → 프로젝트 선택 → 좌측 하단 Settings
#   • URL   : Settings → Data API → Project URL
#   • 키    : Settings → API Keys → service_role (Reveal 클릭)
#
# service_role 키는 RLS를 우회하는 마스터 키입니다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출되니 절대 붙이지 마세요.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────
# 운영자 화면 비밀번호  (필수)
#
# /admin 접속 시 요구됩니다. 신청자 1,300명의 연락처가 보이는 화면이라
# 반드시 설정하세요. 없으면 운영자 화면이 열리지 않습니다.
#
# 32자 이상 무작위 문자열을 권장합니다:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
# 로그인 쿠키 서명용 비밀키. 위와 다른 값으로 만드세요.
ADMIN_SESSION_SECRET=
